// Helper: icon to base64 PNG
async function iconToBase64(IconComponent, color = "#FFFFFF", size = 256) {
  const { default: Comp } = await Promise.resolve({ default: IconComponent });
  const svg = ReactDOMServer.renderToStaticMarkup(
    React.createElement(Comp || IconComponent, { color, size: String(size) })
  );
  const buf = await sharp(Buffer.from(svg)).png().toBuffer();
  return "image/png;base64," + buf.toString("base64");
}

// Build the linked-squares logo motif as SVG → PNG
async function logoMotif(color = "#1F1300", size = 512) {
  // Three squares in an S-shape (data node icon from template)
  const sq = Math.round(size * 0.36);
  const r = Math.round(sq * 0.22);
  const gap = Math.round(size * 0.08);
  // positions: top-right, middle-left, bottom-right
  const positions = [
    { x: size - sq, y: 0 },
    { x: 0, y: (size - sq) / 2 },
    { x: size - sq, y: size - sq },
  ];
  const rects = positions.map(p =>
    `<rect x="${p.x}" y="${p.y}" width="${sq}" height="${sq}" rx="${r}" ry="${r}" fill="${color}"/>`
  ).join("\n");
  const cx = Math.round(size / 2);
  const cy = Math.round(size / 2);
  // connecting lines
  const lines = `
    <line x1="${positions[0].x + sq/2}" y1="${positions[0].y + sq}" x2="${cx}" y2="${cy}" stroke="${color}" stroke-width="${gap*0.5}"/>
    <line x1="${positions[1].x + sq}" y1="${positions[1].y + sq/2}" x2="${cx}" y2="${cy}" stroke="${color}" stroke-width="${gap*0.5}"/>
    <line x1="${positions[2].x + sq/2}" y1="${positions[2].y}" x2="${cx}" y2="${cy}" stroke="${color}" stroke-width="${gap*0.5}"/>
  `;
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">${rects}</svg>`;
  const buf = await sharp(Buffer.from(svg)).png().toBuffer();
  return "image/png;base64," + buf.toString("base64");
}

// Build proper data-node motif (S-shape of 4 rounded squares like in template)
async function buildMotif(fgColor, size = 400) {
  const sq = Math.round(size * 0.30);
  const r = Math.round(sq * 0.25);
  const half = Math.round((size - sq) / 2);
  // Layout: top-left, top-right (offset), mid-left, bottom-right
  // From template: the icon looks like a 2x3 grid with alternating squares connected
  const s = sq;
  const g = Math.round(size * 0.06);
  // 4 squares in S-pattern
  const positions = [
    { x: 0, y: 0 },
    { x: s + g, y: s * 0.5 + g * 0.5 },
    { x: 0, y: s + g },
    { x: s + g, y: s * 1.5 + g * 1.5 },
  ];
  const totalW = s * 2 + g;
  const totalH = s * 2 + g * 2;
  const rects = positions.map(p =>
    `<rect x="${p.x}" y="${p.y}" width="${s}" height="${s}" rx="${r}" ry="${r}" fill="${fgColor}"/>`
  ).join("\n");
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${totalW}" height="${totalH}" viewBox="0 0 ${totalW} ${totalH}">${rects}</svg>`;
  const buf = await sharp(Buffer.from(svg)).png().toBuffer();
  return { data: "image/png;base64," + buf.toString("base64"), w: totalW, h: totalH };
}

